# Copy to the repo root as `.gitattributes`, ideally in the first commit.
# Existing repo: land it as its own commit after `git add --renormalize .` (after the user's OK).
* text=auto eol=lf

# cmd.exe misreads labels in LF batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# SVG is text
*.svg text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mo binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.phar binary
