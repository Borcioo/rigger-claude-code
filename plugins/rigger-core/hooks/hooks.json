{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" --notice -S \"${CLAUDE_PLUGIN_ROOT}/tools/harness_start/harness_start.py\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/context-guard/compact_guard.py\" start || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/state/state.py\" hook || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 1", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 2", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 3", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 4", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 5", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 6", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 1 --subagent", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 2 --subagent", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 3 --subagent", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/assemble/part.sh\" 4 --subagent", "timeout": 10 }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/context-guard/compact_guard.py\" pre --hard-cap 560000 --coordinator-cap 650000 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/context-guard/compact_guard.py\" post || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/context-guard/context_guard.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/side-session-guard/side_session_guard.py\" || true",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/side-session-guard/side_session_guard.py\" || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "if": "Write(//**/.claude/environments.json)", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/env-check/env_check.py\" --hook || true", "timeout": 10 },
          { "type": "command", "if": "Edit(//**/.claude/environments.json)", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/env-check/env_check.py\" --hook || true", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/report-gate/report_shadow.py\" || true",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/side-session-guard/side_session_guard.py\" || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
