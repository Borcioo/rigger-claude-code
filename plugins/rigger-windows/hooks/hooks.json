{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rules/rules_start.sh\" windows.md", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rules/rules_start.sh\" windows-skills.md", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rules/rules_start.sh\" --subagent windows.md", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rules/rules_start.sh\" --subagent windows-skills.md", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --pwsh-all || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --only-git || true",
            "timeout": 10,
            "if": "Bash(*git*)"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --only-git || true",
            "timeout": 10,
            "if": "Bash(*worktree remove *)"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --only-git || true",
            "timeout": 10,
            "if": "Bash(*push *--no-veri*)"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --only-narrow || true",
            "timeout": 5,
            "if": "Bash(*tee *)"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --only-narrow || true",
            "timeout": 5,
            "if": "Bash(*safe-edit*)"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --only-narrow || true",
            "timeout": 5,
            "if": "Bash(*<<*)"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/shell_guard.py\" --only-narrow || true",
            "timeout": 5,
            "if": "Bash(*\\\\\\\\\\\\\\\\*)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/shell-guard/stop_shadow.py\" || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
