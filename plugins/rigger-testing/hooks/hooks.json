{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(*commit*)", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/weak-test-guard/weak_test_guard.py\" || true", "timeout": 20 }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          { "type": "command", "if": "PowerShell(*commit*)", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/py.sh\" -S \"${CLAUDE_PLUGIN_ROOT}/tools/weak-test-guard/weak_test_guard.py\" || true", "timeout": 20 }
        ]
      }
    ]
  }
}
