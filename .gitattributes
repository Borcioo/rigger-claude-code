# LF in the repository and in every checkout, so hooks and rules files keep LF on Windows too.
* text=auto eol=lf

# cmd.exe misreads labels in LF batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# SVG is text
*.svg text eol=lf

